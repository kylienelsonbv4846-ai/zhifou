# Application
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_URL=mysql://classroom_clicker:CHANGE_ME@127.0.0.1:3306/classroom_clicker
# At least 48 characters; recommended: openssl rand -hex 48 (96 hex characters).
CLASSCLICKER_SESSION_SECRET=replace-with-a-strong-random-secret-at-least-48-characters
APP_BASE_URL=https://your-domain.example

# Persistent local file storage (images, generated answer cards, ZIP downloads)
# Use an absolute path on a persistent server volume, outside the release directory.
FILE_STORAGE_DIR=/var/lib/classroom-clicker/uploads
CLASSCLICKER_STORAGE_BACKEND=filesystem

# Tencent Cloud SES: required by email verification and password reset
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SES_REGION=ap-hongkong
SENDER_EMAIL=

# Optional Vite development host allow-list (comma-separated; dev server only)
# VITE_ALLOWED_HOSTS=dev.example.com
